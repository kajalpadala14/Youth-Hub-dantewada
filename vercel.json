{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": [
        "index.html",
        "admin.html",
        "css/**",
        "js/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/YouthHub",
      "destination": "/index.html"
    },
    {
      "source": "/YouthHub/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
