{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/YouthHub",
      "destination": "/index.html"
    },
    {
      "source": "/YouthHub/(.*)",
      "destination": "/$1"
    }
  ]
}
