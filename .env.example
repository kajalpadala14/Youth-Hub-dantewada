# =============================================================================
# YOUTH HUB DANTEWADA - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# District Administration & Zilla Panchayat, Dantewada (Chhattisgarh)
# =============================================================================
# 
# उपयोग विधि (How to use):
# 1. इस फ़ाइल की एक कॉपी बनाकर उसका नाम `.env` रखें।
# 2. अपनी Google Sheet के Apps Script में Deploy करके प्राप्त Web App URL को नीचे पेस्ट करें।
# 3. 'Who has access' को 'Anyone' सेट करना अनिवार्य है।
#
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Apps Script Web App Deployment URL
# -----------------------------------------------------------------------------
# Format: https://script.google.com/macros/s/<YOUR_DEPLOYMENT_ID>/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID_HERE/exec

# Bundler prefixes (Vite / React / Webpack)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID_HERE/exec
REACT_APP_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID_HERE/exec

# -----------------------------------------------------------------------------
# 2. Local Server Settings
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 3. District Administrative Defaults
# -----------------------------------------------------------------------------
DISTRICT_NAME=Dantewada
STATE_NAME=Chhattisgarh
ADMIN_DEFAULT_EMAIL=eo.dantewada@gmail.com
