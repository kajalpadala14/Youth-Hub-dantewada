# =============================================================================
# YOUTH HUB DANTEWADA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the placeholder with your deployed Web App URL
# =============================================================================

# Google Apps Script Web App Deployment URL
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_YOUR_APPS_SCRIPT_DEPLOYMENT_ID_HERE/exec

# Vite / React / Next.js compatible prefixes (if building with bundlers)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_YOUR_APPS_SCRIPT_DEPLOYMENT_ID_HERE/exec
REACT_APP_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbx_YOUR_APPS_SCRIPT_DEPLOYMENT_ID_HERE/exec

# Optional Environment Settings
PORT=3000
NODE_ENV=development
